{
  "library": [],
  "version": "1.2.27",
  "targets": {
    "rtokenPct": 0.65,
    "hedgePct": 0.25,
    "usdtPct": 0.1
  },
  "knobs": {
    "driftPp": 0.1,
    "drawdownMax": 0.025,
    "hedgeBandMin": 0.21,
    "hedgeBandMax": 0.3,
    "eventLookbackHours": 12,
    "blackoutMinutes": 30,
    "concentrationMax": 0.28,
    "staleMaxSeconds": 600
  },
  "clauses": [
    {
      "id": "B1-drift",
      "text": "Only trade when a holding group has wandered far enough from its target share.",
      "threshold": "drift > 10pp",
      "onUnmeasurable": "halt",
      "enabled": true
    },
    {
      "id": "B2-drawdown",
      "text": "If the portfolio is already down on its day, make no trade that adds risk.",
      "threshold": "dd <= 2.5% or risk-reducing",
      "onUnmeasurable": "halt",
      "enabled": true
    },
    {
      "id": "B3-hedge-band",
      "text": "The crypto shield must stay inside its written floor and ceiling.",
      "threshold": "20%-50%",
      "onUnmeasurable": "deny",
      "enabled": true
    },
    {
      "id": "B4-event",
      "text": "A trade needs a big-enough news story within the recent lookback window.",
      "threshold": "severity >= medium within 12h",
      "onUnmeasurable": "halt",
      "enabled": true
    },
    {
      "id": "B5-blackout",
      "text": "Stay quiet in the minutes just before and after the US market opens or closes.",
      "threshold": "outside open/close +/-30min",
      "onUnmeasurable": "deny",
      "enabled": true
    },
    {
      "id": "B6-concentration",
      "text": "No single holding may end up past its size cap after the trade.",
      "threshold": "max position <= 35%",
      "onUnmeasurable": "halt",
      "enabled": true
    },
    {
      "id": "B7-stale",
      "text": "If market prices are too old to trust, stop everything.",
      "threshold": "data age <= 600s",
      "onUnmeasurable": "deny",
      "enabled": true
    }
  ]
}
